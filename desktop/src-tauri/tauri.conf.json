{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rings",
  "mainBinaryName": "Rings",
  "version": "0.1.0",
  "identifier": "com.stillmvd.rings",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rings",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "stillmvd",
    "copyright": "© stillmvd",
    "shortDescription": "Личный таймлайн жизни",
    "longDescription": "Rings — личный таймлайн жизни: события, календарь, отслеживание и дни рождения.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
